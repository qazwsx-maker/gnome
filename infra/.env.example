# copy to infra/.env and fill in
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=gnome
MQTT_PASS=change-me            # must match infra/mosquitto.passwd (mosquitto_passwd -b infra/mosquitto.passwd gnome <pass>)
DATABASE_URL=postgres://pichaya@localhost/gnome
PORT=8080
TZ=Asia/Bangkok
DISCORD_WEBHOOK_URL=           # empty = log to console with [discord] prefix
CORE_PUBLIC_URL=http://192.168.1.111:8080   # URL ที่ node ใช้ดึง firmware OTA (ว่าง = เดา LAN IP อัตโนมัติ)
# Sage — AI วิเคราะห์การเจริญเติบโตจากภาพ Watcher
ANTHROPIC_API_KEY=            # หรือ ANTHROPIC_AUTH_TOKEN · ว่าง = ปุ่มวิเคราะห์ใช้ไม่ได้
SAGE_PROVIDER=anthropic       # anthropic | ollama (ollama = ฟรี ใช้ qwen3.5 ในเครื่อง แต่แม่นน้อยกว่า)
SAGE_MODEL=claude-opus-5
SAGE_MAX_FRAMES=30            # จำนวนภาพสูงสุดต่อการวิเคราะห์ (1 ภาพ/วัน ใกล้เที่ยง)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# เข้าจากนอกบ้าน (Cloudflare Tunnel → gnome.runesteinn.com): ต้อง login ด้วยรหัสนี้ · LAN ไม่ต้อง
HUT_PASSWORD=change-me
HUT_SESSION_SECRET=random-32-bytes
